# Copy to .env for local use. Never commit real values.
PORT=5173

# mysql is the default; use MySQL 8.0.16+ and initialise schema/seed with a separate admin account.
# Use a restricted runtime account below. See docs/commerce.md for setup and privileges.
# memory is an explicit local test adapter only; orders disappear when the server stops.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=saleshi

# Checkout is always simulated. No payment-provider keys belong here.
